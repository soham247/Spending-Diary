# App
DATABASE_URL=postgresql://user:pass@localhost:5432/spending_diary
DIRECT_URL=postgresql://user:pass@localhost:5432/spending_diary
BETTER_AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis (server only; required for protected actions)
KV_REST_API_URL=
KV_REST_API_TOKEN=
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_NAMESPACE=sd:development

# Google OAuth (leave empty to disable in previews)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com

# Cron
CRON_SECRET=change-me
# Web Push (generate a VAPID key pair locally; keep the private key secret)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com
